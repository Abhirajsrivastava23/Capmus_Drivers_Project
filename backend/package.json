{
  "name": "campus-drivers-backend",
  "version": "1.0.0",
  "description": "Backend API and Realtime Server for Campus Drivers - Chandigarh University UP Carpooling Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "node -e \"console.log('Backend build ready')\"",
    "dev": "nodemon src/server.js",
    "seed": "node src/utils/seedData.js",
    "test": "node tests/unit.test.js && node tests/acceptance.test.js && node tests/integration.test.js",
    "test:unit": "node tests/unit.test.js",
    "test:acceptance": "node tests/acceptance.test.js",
    "test:integration": "node tests/integration.test.js"
  },
  "keywords": [
    "carpooling",
    "ridesharing",
    "chandigarh-university",
    "campus-drivers",
